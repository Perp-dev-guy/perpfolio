---
import "../styles/global.css";
import Hero from "../components/index/Hero.astro";
import Navbar from "../components/Navbar.astro";
import Skills from "../components/index/Skills.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="shortcut icon"
      href="/perpfolio.github.io/smile.ico"
      type="image/x-icon"
    />
    <title>Perpfolio</title>
  </head>
  <body
    class="bg-[url('/perpfolio.github.io/noiseblackboard.svg')] bg-contain text-white"
  >
    <Navbar
      links={[
        { name: "Home", link: "/perpfolio.github.io/" },
        { name: "Projects", link: "/perpfolio.github.io/projects" },
        { name: "Contact", link: "/perpfolio.github.io/contact" },
      ]}
    />
    <Hero
      headerText="Solving Complex Problems With Simple Solutions"
      subHeaderText="Hello, I am Perp, and I make creative solutions to complex problems!"
      ctaText="See my projects!"
    />
    <Skills />
  </body>
</html>

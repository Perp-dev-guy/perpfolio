---
import "../styles/global.css";
import Hero from "../components/index/Hero.astro";
import Navbar from "../components/Navbar.astro";
import Skills from "../components/index/Skills.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="/perpfolio/smile.ico" type="image/x-icon" />
    <title>Perpfolio</title>
  </head>
  <body
    class="bg-[url('/perpfolio/noiseblackboard.svg')] bg-contain text-white"
  >
    <Navbar
      links={[
        { name: "Home", link: "/perpfolio/" },
        { name: "Projects", link: "/perpfolio/projects" },
        { name: "Contact", link: "/perpfolio/contact" },
      ]}
    />
    <Hero
      headerText="Solving Complex Problems With Simple Solutions"
      subHeaderText="Hello, I am Perp, and I make creative solutions to complex problems!"
      ctaText="See my projects!"
    />
    <Skills />
    testing
  </body>
</html>
